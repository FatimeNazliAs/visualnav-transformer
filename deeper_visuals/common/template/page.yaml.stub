# deeper_visuals/pN_name/page.yaml
#
# The advisor-facing words. Kept out of run_model.py so `update.sh --page-only`
# can re-render copy without touching a GPU.
#
# Any {dotted.key} is substituted from facts.json, so numbers on the page can
# never drift from the forward pass that produced them.
#
# The two-surface contract (CLAUDE.md): lists, not prose. A short heading, one
# line of framing, 3-6 bullets, one hero visual, a tiny numbers callout, one
# line on where it sits in the paper. ~1 screen. No code, no file paths, no
# unglossed jargon — that all belongs in Notion.
#
# build_page.py enforces the caps, so a page that drifts back into prose fails
# the build rather than the review.

title: <2–4 word artifact name — shows in the browser tab and gallery>
phase_label: PN
eyebrow: "{scene.description}"
heading: <the page's claim, as a headline — under 60 characters>

lead: >
  <One line of framing under the heading. Not a paragraph — under 150
  characters. Assume the reader has never read the paper.>

points:                     # 3 to 6, each under 130 characters
  - <One idea per bullet. <b>bold</b> the key term.>
  - <Assume the reader does not know what an encoder is.>
  - <Numbers come from facts.json as {some.fact.key} so they cannot drift.>

figures:
  - file: <name>.png
    alt: <plain description for screen readers>
    caption: <one line; <b>bold</b> is allowed for the key term>

    # Optional per figure. A collapsed disclosure directly under that picture,
    # answering "what am I looking at" — how to read it, what its parts mean.
    # Omit the key and nothing is rendered. 3-8 points, each under 200
    # characters: longer than a bullet, because the reader chose to open it,
    # but still not a paragraph. Two figures can carry two different ones.
    details:
      summary: <what opening this gets them — under 70 characters>
      points:
        - <One idea per line. <b>bold</b> the key term, same as points above.>
        - <Good use: how to read the picture, or why it was made this way.>

stats:                      # 2 to 5 cells, values pulled from facts.json
  - label: <short label>
    value: "{some.fact.key}"

paper_note: >
  <One line on where this sits in the NoMaD paper.>
