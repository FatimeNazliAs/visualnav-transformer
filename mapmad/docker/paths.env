# Host paths for run_containers.sh. Each line keeps a value that is already set in the environment,
# so `HM3D_SCENES=/other/path mapmad/docker/run_containers.sh up` overrides it for one call.
# (sourced by bash; the worktree path itself is derived from the script's location)

: "${HABITAT_STARTER:=$HOME/projects/habitat-starter}"   # unzipped habitat-starter.zip (build context)
: "${HM3D_SCENES:=/mnt/shared_disk/hm3d/data/scene_datasets/hm3d_v0.2/hm3d_v0.2}"   # read-only, shared
: "${OBJECTNAV_V2:=/mnt/shared_disk/hm3d/data/datasets/objectnav/hm3d/v2}"          # read-only, shared
: "${HM3D_SEMANTICS:=/mnt/shared_disk/nazli/hm3d_semantics_v0.2}"
: "${MAPMAD_DATA:=/mnt/shared_disk/nazli/mapmad_data}"
: "${NOMAD_DATA:=/mnt/shared_disk/nazli/nomad_data}"
: "${NOMAD_OUTPUTS:=/mnt/shared_disk/nazli/nomad_outputs}"
: "${WANDB_CONFIG:=/mnt/shared_disk/nazli/wandb_config}"
: "${RECON_PROCESSED:=/mnt/shared_disk/nazli/nwm_data/recon}"          # Phase 7: RECON in NoMaD format (read-only)
: "${RECON_RAW:=/mnt/shared_disk/nazli/recon_raw/recon_release}"     # Phase 7: RECON hdf5 (read-only)

: "${MODEL_CACHE:=/mnt/shared_disk/nazli/model_cache}"   # Phase 9: recogniser weights (HF_HOME inside naz_mapmad_recog)
: "${HF_TOKEN_DIR:=$HOME/.cache/huggingface}"            # Phase 9: holds `token` (gated SAM 3); mounted read-only

: "${HABITAT_IMAGE:=naz-mapmad-habitat:0.1}"
: "${RECOG_IMAGE:=naz-mapmad-recog:0.1}"
# Container names: a second worktree (Phase 9) sets its own, e.g. HABITAT_CONTAINER=naz_mapmad_habitat_p9
: "${HABITAT_CONTAINER:=naz_mapmad_habitat}"
: "${NOMAD_CONTAINER:=naz_mapmad}"
: "${RECOG_CONTAINER:=naz_mapmad_recog}"
: "${NOMAD_IMAGE:=nomad:latest}"
: "${MAPMAD_NETWORK:=mapmad-net}"
